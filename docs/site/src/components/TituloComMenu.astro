---
// O Starlight não tem como esconder o menu lateral no computador: este botão é uma
// aba na borda do menu. No celular, o menu já abre pelo botão próprio do Starlight.
import Default from "@astrojs/starlight/components/SiteTitle.astro";
---

<script is:inline>
  // Antes de o menu aparecer na tela, para ele não piscar ao trocar de página.
  try {
    if (localStorage.getItem("vintem-menu") === "oculto") document.documentElement.dataset.menuOculto = "";
  } catch {}
</script>

<button type="button" class="alternar-menu" aria-controls="starlight__sidebar" aria-expanded="true" aria-label="Esconder menu" title="Esconder menu">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M15 5l-7 7 7 7"></path>
  </svg>
</button>
<Default />

<script>
  import "../scripts/indice";

  const raiz = document.documentElement;
  const botao = document.querySelector<HTMLButtonElement>(".alternar-menu");

  function mostrar() {
    const oculto = "menuOculto" in raiz.dataset;
    const rotulo = oculto ? "Mostrar menu" : "Esconder menu";
    botao?.setAttribute("aria-expanded", String(!oculto));
    botao?.setAttribute("aria-label", rotulo);
    botao?.setAttribute("title", rotulo);
  }

  botao?.addEventListener("click", () => {
    const ocultar = !("menuOculto" in raiz.dataset);
    if (ocultar) raiz.dataset.menuOculto = "";
    else delete raiz.dataset.menuOculto;
    try {
      localStorage.setItem("vintem-menu", ocultar ? "oculto" : "visivel");
    } catch {}
    mostrar();
  });
  mostrar();
</script>
