# Usado pelo goreleaser (dockers_v2): o binário já vem compilado em
# $TARGETPLATFORM/vintem, então não há RUN e o build arm64 não precisa de emulação.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/vintem /vintem
# O usuário nonroot só grava aqui: é onde ficam vintem.db e o banco do sandbox.
WORKDIR /home/nonroot
EXPOSE 8080
ENTRYPOINT ["/vintem"]
CMD ["serve"]
